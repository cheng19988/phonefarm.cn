# SQLite — local dev (creates ./dev.db in project root)
DATABASE_URL="file:./dev.db"

# Vercel serverless — use absolute /tmp path (relative paths are auto-corrected on Vercel)
# DATABASE_URL="file:/tmp/phonefarm.db"

JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@phonefarm.cn"
ADMIN_PASSWORD="admin123456"
TRON_API_KEY=""

# Optional RFQ notifications (Contact still succeeds if unset or if send fails)
# TELEGRAM_BOT_TOKEN — BotFather bot token (Vercel Production + redeploy)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_NOTIFY_CHAT_ID — chat id that receives RFQ alerts
TELEGRAM_NOTIFY_CHAT_ID=
# See docs/telegram-rfq-notification.md for setup and verification
# CONTACT_WEBHOOK_URL — optional JSON webhook endpoint
CONTACT_WEBHOOK_URL=
